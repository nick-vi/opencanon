{
  "cacheDir": ".opencanon/cache",
  "baselinePath": ".opencanon/baseline.json",
  "entrypoints": [
    "src/api/routes/**/*.ts"
  ],
  "generated": [],
  "ignore": [
    "node_modules/**",
    ".git/**",
    "packages/**/node_modules/**",
    "packages/engine/binaries/**",
    "apps/site/node_modules/**",
    "apps/site/.svelte-kit/**",
    "apps/site/build/**",
    ".opencanon/**",
    "tmp/**",
    "crates/*/target/**"
  ],
  "projectFilePatterns": [
    "src/**/*.{ts,tsx,js,jsx,py,svelte,css,scss,sass,less,json,md}",
    "tests/**/*.{ts,tsx,js,jsx,py,svelte,css,scss,sass,less,json,md}",
    "packages/**/*.{ts,tsx,js,jsx,svelte,css,scss,sass,less,json,md}",
    "apps/site/**/*.{ts,tsx,js,jsx,svelte,css,scss,sass,less,json,md}",
    "docs/**/*.{md,markdown}",
    "*.{md,markdown}",
    "scripts/**/*.{ts,js,mjs}",
    "opencanon/**/*.{ts,md,json}",
    ".agents/skills/**/*.md",
    "crates/opencanon-engine/src/**/*.rs"
  ],
  "publicSurfaces": [
    "src/api/routes/**/*.ts"
  ],
  "requiredPackageScripts": [
    "opencanon"
  ],
  "maxFileSizeKb": 512,
  "maxFiles": 20000,
  "fileDiscovery": "git",
  "externalTools": {},
  "semanticEmbedding": {
    "mode": "native",
    "modelId": "jina-code-v2",
    "showDownloadProgress": true
  }
}
